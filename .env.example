# AWS SDK credential discovery uses your normal AWS profile or environment.
AWS_PROFILE=governai-portfolio
AWS_REGION=us-east-1
GOVERNAI_S3_BUCKET=governai-portfolio-123456789012
GOVERNAI_KMS_KEY_ARN=arn:aws:kms:us-east-1:123456789012:key/example

# Snowflake pipeline identity. Prefer key-pair authentication for CI.
SNOWFLAKE_ACCOUNT=example-account
SNOWFLAKE_USER=GOVERNAI_PIPELINE
SNOWFLAKE_ROLE=GOVAI_PIPELINE_ROLE
SNOWFLAKE_WAREHOUSE=GOVAI_INGEST_WH
SNOWFLAKE_DATABASE=GOVERNAI
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/outside/repository/rsa_key.p8

# dbt uses a separate least-privilege role.
SNOWFLAKE_DBT_ROLE=GOVAI_DBT_ROLE
SNOWFLAKE_DBT_WAREHOUSE=GOVAI_TRANSFORM_WH
DBT_TARGET=prod
